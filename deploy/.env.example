# Copy to .env on the server:  cp .env.example .env  &&  nano .env
# .env is NOT committed to git (see deploy/.gitignore).

# Public address of the system
DOMAIN=iot-manager.duckdns.org

# Email for Let's Encrypt notifications (optional, but recommended)
ACME_EMAIL=

# DuckDNS - subdomain WITHOUT ".duckdns.org" and the token from duckdns.org
DUCKDNS_SUBDOMAIN=iot-manager
DUCKDNS_TOKEN=

# Database password - generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=

# First administrator of the web application (created only on an empty database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Push notifications about alerts (optional, empty = off) - ntfy app on the phone, README step 12.1
#   NTFY_URL=https://ntfy.sh/<random-topic-name>
#   NTFY_TOKEN is only needed for a protected topic / own ntfy server
NTFY_URL=
NTFY_TOKEN=

# Memory settings (defaults are fine for 2 OCPU / 12 GB)
# JAVA_OPTS=-Xms3g -Xmx3g -XX:+AlwaysPreTouch
# PG_SHARED_BUFFERS=1GB
